{
  "name": "@deepseek-ai/dsh-plugin-weave",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Weave v0.2.0 Phase 0 — DSH 多 Agent 团队协作与知识成长框架（插件）",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/plugins/weave/index.js",
  "types": "./dist/plugins/weave/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugins/weave/index.d.ts",
      "default": "./dist/plugins/weave/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:persistence": "vitest run src/plugins/weave/__tests__/persistence.test.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.0",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
